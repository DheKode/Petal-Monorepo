{
  "name": "@petal/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/themes/petal.tokens.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/src/themes/generated/theme.d.mts",
      "import": "./dist/src/themes/generated/theme.mjs",
      "default": "./dist/src/themes/generated/theme.mjs"
    },
    "./theme/native": {
      "types": "./dist/src/themes/generated/native-theme.d.mts",
      "import": "./dist/src/themes/generated/native-theme.mjs",
      "default": "./dist/src/themes/generated/native-theme.mjs"
    },
    "./theme.css": "./dist/src/themes/generated/theme.css",
    "./styles.css": "./dist/src/styles/index.css",
    "./tokens.json": "./src/themes/petal.tokens.json"
  },
  "scripts": {
    "build": "node src/themes/scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/copy-theme.mjs",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "test": "pnpm build && node --test src/themes/scripts/tokens.test.mjs src/themes/scripts/preview.test.mjs test/package.test.mjs",
    "theme:check": "node src/themes/scripts/build.mjs --check"
  },
  "peerDependencies": {
    "react": ">=19.2.3 <20",
    "react-native": "0.86.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3"
  }
}
