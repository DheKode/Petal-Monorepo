{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "maxItems": 2000,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "publisher": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "sectionOrPage": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "excerpt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "publicationDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "retrievalDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "supportedProfileIds": {
        "minItems": 1,
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "reviewStatus": {
        "type": "string",
        "enum": [
          "draft",
          "reviewed",
          "rejected"
        ]
      }
    },
    "required": [
      "id",
      "publisher",
      "title",
      "url",
      "sectionOrPage",
      "excerpt",
      "publicationDate",
      "retrievalDate",
      "supportedProfileIds",
      "version",
      "reviewStatus"
    ],
    "additionalProperties": false
  }
}
