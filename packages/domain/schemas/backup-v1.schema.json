{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "encryption": {
      "type": "string",
      "const": "none"
    },
    "profiles": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "product": {
            "type": "string",
            "const": "Trust 28"
          },
          "formulation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "ingredients": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "strength": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "name",
                "strength"
              ],
              "additionalProperties": false
            }
          },
          "regimen": {
            "type": "string",
            "const": "28-tablet-pack"
          },
          "tabletMap": {
            "minItems": 28,
            "maxItems": 28,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 28
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "active",
                    "non-hormonal",
                    "unverified"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "position",
                "kind",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "leafletVersion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceVersion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "verificationState": {
            "type": "string",
            "enum": [
              "unverified",
              "verified"
            ]
          }
        },
        "required": [
          "id",
          "product",
          "formulation",
          "ingredients",
          "regimen",
          "tabletMap",
          "leafletVersion",
          "evidenceVersion",
          "evidenceIds",
          "verificationState"
        ],
        "additionalProperties": false
      }
    },
    "settings": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "usualTime": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "timeZone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "notificationPreference": {
              "type": "string",
              "enum": [
                "disabled",
                "enabled",
                "permission-denied"
              ]
            },
            "locale": {
              "type": "string",
              "const": "en"
            },
            "modelConfiguration": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "modelId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "artifactSha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "runtime": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "enabled",
                "modelId",
                "artifactSha256",
                "runtime"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "usualTime",
            "timeZone",
            "notificationPreference",
            "locale",
            "modelConfiguration"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "packs": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "scheduleVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "transitionState": {
            "type": "string",
            "enum": [
              "planned",
              "current",
              "completed",
              "delayed",
              "uncertain"
            ]
          }
        },
        "required": [
          "id",
          "profileId",
          "startDate",
          "scheduleVersion",
          "transitionState"
        ],
        "additionalProperties": false
      }
    },
    "scheduledDoses": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "packId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 28
          },
          "tabletKind": {
            "type": "string",
            "enum": [
              "active",
              "non-hormonal",
              "unverified"
            ]
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "localDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "packId",
          "position",
          "tabletKind",
          "scheduledAt",
          "localDate",
          "timeZone"
        ],
        "additionalProperties": false
      }
    },
    "intakeEvents": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "doseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "taken",
              "confirmed-missed",
              "unsure"
            ]
          },
          "actualAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "timePrecision": {
            "type": "string",
            "enum": [
              "exact",
              "approximate",
              "unknown"
            ]
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "origin": {
            "type": "string",
            "enum": [
              "manual",
              "chat",
              "import"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "doseId",
          "status",
          "actualAt",
          "timePrecision",
          "timeZone",
          "origin",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "auditEntries": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "entityType": {
            "type": "string",
            "enum": [
              "profile",
              "settings",
              "pack",
              "scheduled-dose",
              "intake-event",
              "bleeding-entry"
            ]
          },
          "priorValue": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "type": "null"
              }
            ]
          },
          "newValue": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "origin": {
            "type": "string",
            "enum": [
              "manual",
              "chat",
              "import"
            ]
          }
        },
        "required": [
          "id",
          "entityId",
          "entityType",
          "priorValue",
          "newValue",
          "timestamp",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "bleedingEntries": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "spotting",
              "bleeding"
            ]
          },
          "intensity": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "light",
                  "moderate",
                  "heavy"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "startDate",
          "endDate",
          "category",
          "intensity",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sectionOrPage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "publicationDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrievalDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "supportedProfileIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "reviewed",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "publisher",
          "title",
          "url",
          "sectionOrPage",
          "excerpt",
          "publicationDate",
          "retrievalDate",
          "supportedProfileIds",
          "version",
          "reviewStatus"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "appVersion",
    "exportedAt",
    "encryption",
    "profiles",
    "settings",
    "packs",
    "scheduledDoses",
    "intakeEvents",
    "auditEntries",
    "bleedingEntries",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  },
  "title": "Petal backup v1",
  "description": "Structural interchange schema. Also run parseBackup for calendar, uncertainty, product applicability and referential integrity validation."
}
