{
  "name": "@petal/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Petal desktop app (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @petal/storage build && electron-vite dev",
    "build": "pnpm --filter @petal/storage build && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm --filter @petal/storage build && tsc",
    "package:dir": "pnpm run build && electron-builder --dir",
    "test": "pnpm --filter @petal/storage build && tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@petal/domain": "workspace:*",
    "@petal/storage": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@libsql/client": "0.18.0"
  }
}
